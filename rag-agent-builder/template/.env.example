# .env로 복사하고 키를 넣는다 (.env는 git에 올리지 않는다)

# 기본: Google Gemini (답변·채점·임베딩·그림 변환)
GOOGLE_API_KEY=

# 다른 모델을 쓸 때 (provider 이름은 LangChain init_chat_model 기준, 패키지 설치 필요)
# LLM_PROVIDER=openai            # google_genai / openai / anthropic
# LLM_MODEL=<채팅 모델 이름>
# VISION_MODEL=<이미지 입력 되는 모델>
# JUDGE_MODEL=<채점 모델, 실험 내내 고정>
# EMBEDDING_PROVIDER=openai      # anthropic은 임베딩이 없다
# EMBEDDING_MODEL=<임베딩 모델 이름>
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
